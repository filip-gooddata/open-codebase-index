{
  "scope": "project",
  "embeddingProvider": "ollama",
  "embeddingModel": "qwen3-embedding:0.6b",
  "indexing": {
    "mode": "hybrid",
    "autoIndex": true,
    "watchFiles": true,
    "autoIndexWaitMs": 360000,
    "autoIndexMaxRetries": 10,
    "autoIndexRetryDelayMs": 1000
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/*.map"
  ]
}
