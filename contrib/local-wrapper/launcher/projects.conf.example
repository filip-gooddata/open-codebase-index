# name|git common dir. Each listed project shares $OCBI_HOME/<name>/{claude-index,codebase-index.json}
# across all its worktrees. Names are [A-Za-z0-9][A-Za-z0-9_-]*. The git common dir is what
# `git rev-parse --path-format=absolute --git-common-dir` prints inside any worktree: <clone>/.git
# for a normal clone, the clone directory itself for a bare clone. See ocbi-mcp.sh.
#
# Before a project is linked, create $OCBI_HOME/<name>/codebase-index.json (start from
# codebase-index.example.json) and add these two lines to <git common dir>/info/exclude:
#   .claude/index
#   .claude/codebase-index.json
#
# myproject|/home/me/src/myproject/.git
# mybare|/home/me/src/mybare.git
