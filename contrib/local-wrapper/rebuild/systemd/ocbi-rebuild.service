# On-demand full rebuild (ocbi-rebuild.sh), started by `ocbi-rebuild [CHECKOUT]` so the run
# outlives the terminal and the session. No schedule and no [Install] section: nothing starts it
# by itself. install.sh fills in @OCBI_HOME@ and @PATH@.
[Unit]
Description=Codebase index: full rebuild of a shared store

[Service]
Type=exec
ExecStart=/bin/bash @OCBI_HOME@/ocbi-rebuild.sh
Environment=PATH=@PATH@
Nice=10
